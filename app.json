{
  "expo": {
    "name": "CivicFix SOS",
    "slug": "civicfix-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "civicfixsos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.civicfix.sos",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      }
    },
    "android": {
      "package": "com.civicfix.sos",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#0B4F6C"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B4F6C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-task-manager",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "CivicFix SOS needs background location access to continue sharing your location even when the app is minimised during an active SOS emergency.",
          "locationAlwaysPermission": "CivicFix SOS needs background location access to continue sharing your location even when the app is minimised during an active SOS emergency.",
          "locationWhenInUsePermission": "CivicFix SOS uses your location to share it with your emergency contacts during an SOS session.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "./plugins/withReceiveBootCompleted"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3a8506a4-2f2e-44d9-90f6-248a182274cb"
      },
      "apiBaseUrl": "https://civicfix-backend.vercel.app/api",
      "apiBaseUrlDev": "https://civicfix-backend.vercel.app/api"
    },
    "owner": "shimbojr"
  }
}